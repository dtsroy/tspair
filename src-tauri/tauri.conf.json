{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tspair",
  "version": "2.0.0",
  "identifier": "dev.dtsroy.tspair",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tspair",
        "width": 480,
        "height": 760,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "",
    "shortDescription": "tspair",
    "longDescription": "Mutual connection tool between two paired devices over Tailscale.",
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
